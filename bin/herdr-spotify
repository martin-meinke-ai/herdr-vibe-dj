            "dnb": ["energetic drum and bass coding", "neurofunk liquid dnb"],
        },
    },
}


TIER_ENERGY_MODIFIERS: dict[str, str] = {
    "zen": "calm chill",
    "flow": "groove",
    "cranking": "upbeat driving",
    "overdrive": "high energy",
}


def _parse_preference_queries(raw: str) -> list[str]:
    parts = [p.strip() for p in re.split(r"[,;\n]+", raw or "") if p.strip()]
    return parts[:8]


def _custom_queries_for_tier(
    tier: str,
    taste: str = "",
    custom_queries: dict[str, str] | None = None,
) -> list[str]:
    assert tier in VIBE_PRESETS, f"Unknown tier: {tier}"
    per_tier = (custom_queries or {}).get(tier) or ""
    explicit = _parse_preference_queries(per_tier)
    if explicit:
        return explicit
    taste_parts = _parse_preference_queries(taste)
    if taste_parts:
        mod = TIER_ENERGY_MODIFIERS[tier]
        return [f"{part} {mod}" for part in taste_parts]
    return []


def compute_vibe_tier(working_agents: int, inverse: bool = False) -> str:
    count = max(0, working_agents)
    if count <= 1:
        idx = 0
    elif count <= 3:
        idx = 1
    elif count <= 5:
        idx = 2
    else:
        idx = 3
    order = ("overdrive", "cranking", "flow", "zen") if inverse else ("zen", "flow", "cranking", "overdrive")
    return order[idx]


def suggest_tracks(
    intensity: str = "flow",
    vibe: str | None = None,
    offset: int = 0,
    limit: int = 5,
    taste: str | None = None,
    custom_queries: dict[str, str] | None = None,
) -> dict[str, Any]:
    tier = intensity if intensity in VIBE_PRESETS else "flow"
    preset = VIBE_PRESETS[tier]
    vibes_map: dict[str, list[str]] = dict(preset["vibes"])
    if taste is None and custom_queries is None:
        saved = _load_vibe_dj_state()
        eff_taste = saved.get("taste") or ""
        eff_custom = saved.get("custom_queries") or {}
    else:
        eff_taste = taste or ""
        eff_custom = custom_queries or {}
    tier_custom = _custom_queries_for_tier(tier, taste=eff_taste, custom_queries=eff_custom)
    if tier_custom:
        vibes_map = {"custom": tier_custom, **vibes_map}
    vibe_keys = list(vibes_map.keys())
    selected_vibe = vibe if vibe in vibes_map else vibe_keys[0]
    queries = vibes_map[selected_vibe]
    query = queries[abs(int(offset)) % len(queries)]
    search_offset = (abs(int(offset)) // len(queries)) * limit

    _, data = _api_request(
        "GET",
        "/search",
        params={
            "q": query,
            "type": "track",
            "limit": max(1, min(10, int(limit))),
            "offset": min(50, search_offset),
        },
    )
    items = ((data or {}).get("tracks") or {}).get("items") or []
    tracks = []
    for item in items:
        if not item or not item.get("uri"):
            continue
        artists = ", ".join(a.get("name", "") for a in (item.get("artists") or []) if a.get("name"))
        tracks.append(
            {
                "id": item.get("id"),
                "uri": item.get("uri"),
                "track": item.get("name") or "",
                "artists": artists,
                "album": (item.get("album") or {}).get("name") or "",
                "duration_ms": int(item.get("duration_ms") or 0),
                "track_url": (item.get("external_urls") or {}).get("spotify"),
            }
        )
    return {
        "tier": tier,
        "label": preset["label"],
        "subtitle": preset["subtitle"],
        "vibe": selected_vibe,
        "available_vibes": vibe_keys,
        "query": query,
        "tracks": tracks,
    }


def play_uri(uri: str) -> dict[str, Any]:
    cleaned = uri.strip()
    assert cleaned.startswith("spotify:"), f"Invalid Spotify URI: {cleaned}"
    if cleaned.startswith("spotify:track:") or cleaned.startswith("spotify:episode:"):
        _api_request("PUT", "/me/player/play", json_body={"uris": [cleaned]})
    else:
        _api_request("PUT", "/me/player/play", json_body={"context_uri": cleaned})
    _invalidate_cache()
    time.sleep(0.25)
    return get_status(force=True)


def queue_uri(uri: str) -> dict[str, Any]:
    cleaned = uri.strip()
    assert cleaned.startswith("spotify:track:") or cleaned.startswith("spotify:episode:"), (
        f"Queue requires a track or episode URI: {cleaned}"
    )
    _api_request("POST", "/me/player/queue", params={"uri": cleaned})
    return {"ok": True, "queued": cleaned}


@contextmanager
def _vibe_dj_lock() -> Iterator[None]:
    _ensure_spotify_dir()
    with VIBE_DJ_LOCK_PATH.open("a+", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def _default_vibe_dj_state() -> dict[str, Any]:
    return {
        "enabled": False,
        "inverse": False,
        "tier_override": None,
        "vibe": None,
        "taste": "",
        "custom_queries": {},
        "target_queue_depth": VIBE_DJ_DEFAULT_DEPTH,
        "offset": 0,
        "recent_uris": [],
        "queued_tracks": [],
        "last_tier": None,
        "last_vibe": None,
        "last_playing_uri": None,
        "queued_for_playing_uri": None,
        "next_queue_in_s": None,
        "last_tick_at": 0.0,
        "last_queued_at": 0.0,
        "last_action": "off",
        "last_error": "",
    }


def _load_vibe_dj_state() -> dict[str, Any]:
    _ensure_spotify_dir()
    raw = read_json(VIBE_DJ_STATE_PATH, default={})
    state = _default_vibe_dj_state()
    if isinstance(raw, dict):
        state["enabled"] = bool(raw.get("enabled", False))
        state["inverse"] = bool(raw.get("inverse", False))
        tier_override = raw.get("tier_override")
        state["tier_override"] = tier_override if tier_override in VIBE_PRESETS else None
        vibe = raw.get("vibe")
        state["vibe"] = str(vibe) if isinstance(vibe, str) and vibe else None
        taste_raw = raw.get("taste")
        state["taste"] = str(taste_raw).strip()[:200] if isinstance(taste_raw, str) else ""
        cq_raw = raw.get("custom_queries")
        if isinstance(cq_raw, dict):
            state["custom_queries"] = {
                str(k): str(v).strip()[:200]
                for k, v in cq_raw.items()
                if k in VIBE_PRESETS and isinstance(v, str) and v.strip()
            }
        depth = int(raw.get("target_queue_depth") or VIBE_DJ_DEFAULT_DEPTH)
        state["target_queue_depth"] = max(1, min(VIBE_DJ_MAX_DEPTH, depth))
        state["offset"] = max(0, int(raw.get("offset") or 0))
        recent = raw.get("recent_uris")
        state["recent_uris"] = [str(u) for u in recent if isinstance(u, str) and u][-VIBE_DJ_RECENT_LIMIT:] if isinstance(recent, list) else []
        queued = raw.get("queued_tracks")
        state["queued_tracks"] = [dict(t) for t in queued if isinstance(t, dict) and t.get("uri")] if isinstance(queued, list) else []
        state["last_tier"] = raw.get("last_tier") if raw.get("last_tier") in VIBE_PRESETS else None
        state["last_vibe"] = str(raw["last_vibe"]) if isinstance(raw.get("last_vibe"), str) else None
        lp = raw.get("last_playing_uri")
        state["last_playing_uri"] = str(lp) if isinstance(lp, str) and lp else None
        qfp = raw.get("queued_for_playing_uri")
        state["queued_for_playing_uri"] = str(qfp) if isinstance(qfp, str) and qfp else None
        nqi = raw.get("next_queue_in_s")
        state["next_queue_in_s"] = int(nqi) if isinstance(nqi, (int, float)) else None
        state["last_tick_at"] = float(raw.get("last_tick_at") or 0.0)
        state["last_queued_at"] = float(raw.get("last_queued_at") or 0.0)
        state["last_action"] = str(raw.get("last_action") or ("armed" if state["enabled"] else "off"))
        state["last_error"] = str(raw.get("last_error") or "")
    return state


def _save_vibe_dj_state(state: dict[str, Any]) -> None:
    _ensure_spotify_dir()
    atomic_write_json(VIBE_DJ_STATE_PATH, state)


def _resolve_vibe_selection(
    working_agents: int,
    tier_override: str | None,
    vibe: str | None,
    inverse: bool = False,
    taste: str = "",
    custom_queries: dict[str, str] | None = None,
) -> tuple[str, str, str]:
    assert tier_override is None or tier_override in VIBE_PRESETS, f"Invalid tier_override: {tier_override}"
    auto_tier = compute_vibe_tier(working_agents, inverse=inverse)
    effective_tier = tier_override or auto_tier
    vibes_map: dict[str, list[str]] = dict(VIBE_PRESETS[effective_tier]["vibes"])
    has_custom = bool(_custom_queries_for_tier(effective_tier, taste=taste, custom_queries=custom_queries))
    if has_custom:
        vibes_map = {"custom": ["custom"], **vibes_map}
    vibe_keys = list(vibes_map.keys())
    effective_vibe = vibe if vibe in vibes_map else vibe_keys[0]
    return auto_tier, effective_tier, effective_vibe


def _format_vibe_dj_response(
    state: dict[str, Any],
    *,
    working_agents: int = 0,
    added: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    taste = str(state.get("taste") or "")
    custom_queries = dict(state.get("custom_queries") or {})
    auto_tier, effective_tier, effective_vibe = _resolve_vibe_selection(
        working_agents,
        state.get("tier_override"),
        state.get("vibe"),
        inverse=bool(state.get("inverse", False)),
        taste=taste,
        custom_queries=custom_queries,
    )
    has_custom = bool(_custom_queries_for_tier(effective_tier, taste=taste, custom_queries=custom_queries))
    queued = list(state.get("queued_tracks") or [])
    return {
        "ok": True,
        "enabled": bool(state.get("enabled")),
        "inverse": bool(state.get("inverse", False)),
        "tier": effective_tier,
        "auto_tier": auto_tier,
        "tier_override": state.get("tier_override"),
        "vibe": effective_vibe,
        "taste": taste,
        "custom_queries": custom_queries,
        "has_custom": has_custom,
        "target_queue_depth": int(state.get("target_queue_depth") or VIBE_DJ_DEFAULT_DEPTH),
        "working_agents": max(0, int(working_agents)),
        "queued_ahead": queued,
        "queued_ahead_count": len(queued),
        "added": list(added or []),
        "next_queue_in_s": state.get("next_queue_in_s"),
        "last_action": state.get("last_action") or ("armed" if state.get("enabled") else "off"),
        "last_error": state.get("last_error") or "",
        "last_tick_at": float(state.get("last_tick_at") or 0.0),
        "last_queued_at": float(state.get("last_queued_at") or 0.0),
    }


def get_queue() -> dict[str, Any]:
    _, data = _api_request("GET", "/me/player/queue")
    data = data if isinstance(data, dict) else {}
    cur = data.get("currently_playing")
    cur_uri = cur.get("uri") if isinstance(cur, dict) else None
    raw_queue = data.get("queue") or []
    queue_items = []
    for item in raw_queue:
        if not isinstance(item, dict) or not item.get("uri"):
            continue
        artists = ", ".join(a.get("name", "") for a in (item.get("artists") or []) if a.get("name"))
        queue_items.append(
            {
                "id": item.get("id"),
                "uri": item.get("uri"),
                "track": item.get("name") or "",
                "artists": artists,
                "duration_ms": int(item.get("duration_ms") or 0),
            }
        )
    return {
        "currently_playing_uri": cur_uri,
        "queue": queue_items,
    }


def _vibe_dj_tick_locked(
    state: dict[str, Any],
    *,
    working_agents: int = 0,
    force: bool = False,
) -> dict[str, Any]:
    now = time.time()
    taste = str(state.get("taste") or "")
    custom_queries = dict(state.get("custom_queries") or {})
    auto_tier, effective_tier, effective_vibe = _resolve_vibe_selection(
        working_agents,
        state.get("tier_override"),
        state.get("vibe"),
        inverse=bool(state.get("inverse", False)),
        taste=taste,
        custom_queries=custom_queries,
    )
    if not state.get("enabled"):
        state["next_queue_in_s"] = None
        return _format_vibe_dj_response(state, working_agents=working_agents)

    if not force and (now - float(state.get("last_tick_at") or 0.0)) < VIBE_DJ_MIN_TICK_INTERVAL_S:
        return _format_vibe_dj_response(state, working_agents=working_agents)

    status = get_status(force=force)
    if not status.get("authenticated"):
        state["last_action"] = "not_authenticated"
        state["last_error"] = status.get("error") or ""
        state["next_queue_in_s"] = None
        state["last_tick_at"] = now
        _save_vibe_dj_state(state)
        return _format_vibe_dj_response(state, working_agents=working_agents)

    if not status.get("active"):
        state["last_action"] = "idle"
        state["last_error"] = ""
        state["next_queue_in_s"] = None
        state["last_tick_at"] = now
        _save_vibe_dj_state(state)
        return _format_vibe_dj_response(state, working_agents=working_agents)

    if not status.get("is_playing"):
        state["last_action"] = "paused"
        state["last_error"] = ""
        state["next_queue_in_s"] = None
        state["last_tick_at"] = now
        _save_vibe_dj_state(state)
        return _format_vibe_dj_response(state, working_agents=working_agents)

    added: list[dict[str, Any]] = []
    try:
        track_id = status.get("track_id")
        current_uri = _track_uri(track_id) if isinstance(track_id, str) and track_id else None
        duration_ms = max(0, int(status.get("duration_ms") or 0))
        progress_ms = max(0, int(status.get("progress_ms") or 0))
        remaining_ms = max(0, duration_ms - progress_ms) if duration_ms > 0 else 0

        recent_uris: list[str] = list(state.get("recent_uris") or [])
        if current_uri and current_uri not in recent_uris:
            recent_uris.append(current_uri)

        # If the playing track advanced, drop it from queued_tracks and clear the per-track guard
        still_queued = [
            item
            for item in (state.get("queued_tracks") or [])
            if item.get("uri") and item.get("uri") != current_uri
        ]
        if current_uri and current_uri != state.get("last_playing_uri"):
            state["queued_for_playing_uri"] = None

        already_queued_for_track = bool(
            current_uri and state.get("queued_for_playing_uri") == current_uri and still_queued
        )

        if already_queued_for_track and not force:
            state["recent_uris"] = recent_uris[-VIBE_DJ_RECENT_LIMIT:]
            state["queued_tracks"] = still_queued
            state["last_playing_uri"] = current_uri
            state["last_tier"] = effective_tier
            state["last_vibe"] = effective_vibe
            state["next_queue_in_s"] = None
            state["last_action"] = "steady"
            state["last_error"] = ""
            state["last_tick_at"] = now
            _save_vibe_dj_state(state)
            return _format_vibe_dj_response(state, working_agents=working_agents)

        # Just-in-time: wait until <= 60s left in the current track unless forced
        if not force and duration_ms > 0 and remaining_ms > VIBE_DJ_LEAD_TIME_MS:
            wait_s = max(1, (remaining_ms - VIBE_DJ_LEAD_TIME_MS + 999) // 1000)
            state["recent_uris"] = recent_uris[-VIBE_DJ_RECENT_LIMIT:]
            state["queued_tracks"] = still_queued
            state["last_playing_uri"] = current_uri
            state["last_tier"] = effective_tier
            state["last_vibe"] = effective_vibe
            state["next_queue_in_s"] = wait_s
            state["last_action"] = "waiting"
            state["last_error"] = ""
            state["last_tick_at"] = now
            _save_vibe_dj_state(state)
            return _format_vibe_dj_response(state, working_agents=working_agents)

        # Within 60s of track end (or forced): queue 1 fresh track matching live tier/vibe
        q_info = get_queue()
        q_cur_uri = q_info.get("currently_playing_uri") or current_uri
        if q_cur_uri and q_cur_uri not in recent_uris:
            recent_uris.append(q_cur_uri)
        upcoming_uris = {item["uri"] for item in (q_info.get("queue") or [])[:5] if item.get("uri")}

        hard_excluded = upcoming_uris | {item["uri"] for item in still_queued} | ({q_cur_uri} if q_cur_uri else set())
        soft_excluded = hard_excluded | set(recent_uris)

        offset = int(state.get("offset") or 0)
        candidates: list[dict[str, Any]] = []
        fallback_candidates: list[dict[str, Any]] = []
        seen_uris: set[str] = set()
        for attempt in range(3):
            res = suggest_tracks(
                intensity=effective_tier,
                vibe=effective_vibe,
                offset=offset + attempt,
                limit=10,
                taste=taste,
                custom_queries=custom_queries,
            )
            for tr in res.get("tracks") or []:
                uri = tr.get("uri")
                if not uri or uri in seen_uris or uri in hard_excluded:
                    continue
                seen_uris.add(uri)
                if uri not in soft_excluded:
                    candidates.append(tr)
                else:
                    fallback_candidates.append(tr)
            if candidates:
                break

        picks = (candidates + fallback_candidates)[:1]
        for tr in picks:
            queue_uri(tr["uri"])
            entry = {
                "uri": tr["uri"],
                "track": tr.get("track") or "",
                "artists": tr.get("artists") or "",
                "duration_ms": int(tr.get("duration_ms") or 0),
                "tier": effective_tier,
                "vibe": effective_vibe,
                "queued_at": now,
            }
            still_queued = [entry]
            added.append(entry)
            if tr["uri"] not in recent_uris:
                recent_uris.append(tr["uri"])

        state["recent_uris"] = recent_uris[-VIBE_DJ_RECENT_LIMIT:]
        state["queued_tracks"] = still_queued
        state["queued_for_playing_uri"] = q_cur_uri if added else state.get("queued_for_playing_uri")
        state["last_playing_uri"] = q_cur_uri
        state["offset"] = (offset + 1) % 30 if added else offset
        state["last_tier"] = effective_tier
        state["last_vibe"] = effective_vibe
        state["next_queue_in_s"] = None
        state["last_tick_at"] = now
        state["last_error"] = ""
        if added:
            state["last_queued_at"] = now
            state["last_action"] = "queued:1"
        else:
            state["last_action"] = "steady"
    except Exception as exc:
        state["last_action"] = "error"
        state["last_error"] = str(exc)
        state["last_tick_at"] = now

    _save_vibe_dj_state(state)
    return _format_vibe_dj_response(state, working_agents=working_agents, added=added)


def get_vibe_dj_status(working_agents: int = 0) -> dict[str, Any]:
    with _vibe_dj_lock():
        state = _load_vibe_dj_state()
        return _format_vibe_dj_response(state, working_agents=working_agents)


def set_vibe_dj(
    *,
    enabled: bool | None = None,
    inverse: bool | None = None,
    tier_override: str | None = _UNSET,
    vibe: str | None = _UNSET,
    taste: str | None = _UNSET,
    tier_queries: dict[str, str | None] | None = None,
    target_queue_depth: int | None = None,
    working_agents: int = 0,
    sync_now: bool = True,
) -> dict[str, Any]:
    if tier_override is not _UNSET and tier_override is not None:
        if tier_override not in VIBE_PRESETS:
            raise ValueError(f"Invalid tier: {tier_override}")
    if tier_queries is not None:
        for k in tier_queries:
            if k not in VIBE_PRESETS:
                raise ValueError(f"Invalid tier in tier_queries: {k}")
    if target_queue_depth is not None:
        if not (1 <= int(target_queue_depth) <= VIBE_DJ_MAX_DEPTH):
            raise ValueError(f"target_queue_depth must be between 1 and {VIBE_DJ_MAX_DEPTH}")

    with _vibe_dj_lock():
        state = _load_vibe_dj_state()
        if enabled is not None:
            state["enabled"] = bool(enabled)
            if not state["enabled"]:
                state["last_action"] = "off"
                state["last_error"] = ""
        if inverse is not None:
            state["inverse"] = bool(inverse)
        if tier_override is not _UNSET:
            state["tier_override"] = tier_override
        custom_updated = False
        if taste is not _UNSET:
            state["taste"] = str(taste or "").strip()[:200]
            custom_updated = True
        if tier_queries is not None:
            cq = dict(state.get("custom_queries") or {})
            for k, val in tier_queries.items():
                cleaned = str(val or "").strip()[:200]
                if cleaned:
                    cq[k] = cleaned
                else:
                    cq.pop(k, None)
            state["custom_queries"] = cq
            custom_updated = True
        if vibe is not _UNSET:
            state["vibe"] = vibe
        elif custom_updated:
            _, eff_tier, _ = _resolve_vibe_selection(
                working_agents,
                state.get("tier_override"),
                None,
                inverse=bool(state.get("inverse", False)),
                taste=state.get("taste") or "",
                custom_queries=state.get("custom_queries") or {},
            )
            if _custom_queries_for_tier(eff_tier, taste=state.get("taste") or "", custom_queries=state.get("custom_queries") or {}):
                state["vibe"] = "custom"
            elif state.get("vibe") == "custom":
                state["vibe"] = None
        if target_queue_depth is not None:
            state["target_queue_depth"] = int(target_queue_depth)

        _save_vibe_dj_state(state)
        if state["enabled"] and sync_now:
            return _vibe_dj_tick_locked(state, working_agents=working_agents, force=False)
        return _format_vibe_dj_response(state, working_agents=working_agents)


def tick_vibe_dj(working_agents: int = 0, force: bool = False) -> dict[str, Any]:
    with _vibe_dj_lock():
        state = _load_vibe_dj_state()
        if not state.get("enabled"):
            return _format_vibe_dj_response(state, working_agents=working_agents)
        return _vibe_dj_tick_locked(state, working_agents=working_agents, force=force)


def main() -> int:
    parser = argparse.ArgumentParser(prog="herdr-spotify")
    parser.add_argument("--_auth-worker", action="store_true", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="cmd")

    p_status = sub.add_parser("status")
    p_status.add_argument("--refresh", action="store_true")

    p_set = sub.add_parser("set-client-id")
    p_set.add_argument("client_id")
    p_set.add_argument("--redirect-uri", default=None)

    sub.add_parser("auth-start")
    sub.add_parser("auth-status")

    p_complete = sub.add_parser("auth-complete")
    p_complete.add_argument("url_or_code")

    sub.add_parser("logout")

    for name in ("play", "pause", "toggle", "next", "prev"):
        sub.add_parser(name)

    p_seek = sub.add_parser("seek")
    p_seek.add_argument("position_ms", type=int)

    p_vol = sub.add_parser("volume")
    p_vol.add_argument("percent", type=int)

    p_shuf = sub.add_parser("shuffle")
    p_shuf.add_argument("state", choices=["on", "off"])

    p_rep = sub.add_parser("repeat")
    p_rep.add_argument("state", choices=["off", "context", "track"])

    p_like = sub.add_parser("like")
    p_like.add_argument("track_id")
    p_like.add_argument("state", choices=["on", "off"])

    sub.add_parser("devices")

    p_transfer = sub.add_parser("transfer")
    p_transfer.add_argument("device_id")

    p_suggest = sub.add_parser("suggest")
    p_suggest.add_argument("--intensity", default="flow", choices=["zen", "flow", "cranking", "overdrive"])
    p_suggest.add_argument("--vibe", default=None)
    p_suggest.add_argument("--offset", type=int, default=0)
    p_suggest.add_argument("--limit", type=int, default=5)

    p_play_uri = sub.add_parser("play-uri")
    p_play_uri.add_argument("uri")

    p_queue_uri = sub.add_parser("queue-uri")
    p_queue_uri.add_argument("uri")

    p_dj_status = sub.add_parser("vibe-dj-status")
    p_dj_status.add_argument("--working-agents", type=int, default=0)

    p_dj_set = sub.add_parser("vibe-dj-set")
    p_dj_set.add_argument("--enabled", choices=["on", "off"], default=None)
    p_dj_set.add_argument("--inverse", choices=["on", "off"], default=None)
    p_dj_set.add_argument("--tier", choices=["auto", "zen", "flow", "cranking", "overdrive"], default=None)
    p_dj_set.add_argument("--vibe", default=None)
    p_dj_set.add_argument("--taste", default=None)
    p_dj_set.add_argument("--tier-query", action="append", default=None, help="TIER=QUERY (empty QUERY clears)")
    p_dj_set.add_argument("--depth", type=int, default=None)
    p_dj_set.add_argument("--working-agents", type=int, default=0)
    p_dj_set.add_argument("--no-sync", action="store_true")

    p_dj_tick = sub.add_parser("vibe-dj-tick")
    p_dj_tick.add_argument("--working-agents", type=int, default=0)
    p_dj_tick.add_argument("--force", action="store_true")

    args = parser.parse_args()

    if args._auth_worker:
        return run_auth_worker()

    try:
        cmd = args.cmd or "status"
        if cmd == "status":
            out = get_status(force=getattr(args, "refresh", False))
        elif cmd == "set-client-id":
            out = set_client_id(args.client_id, redirect_uri=args.redirect_uri)
        elif cmd == "auth-start":
            out = start_auth()
        elif cmd == "auth-status":
            out = get_auth_status()
        elif cmd == "auth-complete":
            out = complete_auth_from_input(args.url_or_code)
        elif cmd == "logout":
            out = logout()
        elif cmd in ("play", "pause", "toggle", "next", "prev"):
            out = control_playback(cmd)
        elif cmd == "seek":
            out = control_playback("seek", value=str(args.position_ms))
        elif cmd == "volume":
            out = control_playback("volume", value=str(args.percent))
        elif cmd == "shuffle":
            out = control_playback("shuffle", value=args.state)
        elif cmd == "repeat":
            out = control_playback("repeat", value=args.state)
        elif cmd == "like":
            out = control_playback("like", value=args.state, track_id=args.track_id)
        elif cmd == "devices":
            out = list_devices()
        elif cmd == "transfer":
            out = control_playback("transfer", value=args.device_id)
        elif cmd == "suggest":
            out = suggest_tracks(
                intensity=args.intensity,
                vibe=args.vibe,
                offset=args.offset,
                limit=args.limit,
            )
        elif cmd == "play-uri":
            out = play_uri(args.uri)
        elif cmd == "queue-uri":
            out = queue_uri(args.uri)
        elif cmd == "vibe-dj-status":
            out = get_vibe_dj_status(working_agents=args.working_agents)
        elif cmd == "vibe-dj-set":
            kwargs = {
                "working_agents": args.working_agents,
                "sync_now": not args.no_sync,
            }
            if args.enabled is not None:
                kwargs["enabled"] = args.enabled == "on"
            if args.inverse is not None:
                kwargs["inverse"] = args.inverse == "on"
            if args.tier is not None:
                kwargs["tier_override"] = None if args.tier == "auto" else args.tier
            if args.vibe is not None:
                kwargs["vibe"] = None if args.vibe == "auto" else args.vibe
            if args.taste is not None:
                kwargs["taste"] = args.taste
            if args.tier_query:
                tq = {}
                for item in args.tier_query:
                    if "=" not in item:
                        raise ValueError(f"Expected TIER=QUERY, got: {item}")
                    tier_k, query_v = item.split("=", 1)
                    tq[tier_k.strip()] = query_v.strip()
                kwargs["tier_queries"] = tq
            if args.depth is not None:
                kwargs["target_queue_depth"] = args.depth
            out = set_vibe_dj(**kwargs)
        elif cmd == "vibe-dj-tick":
            out = tick_vibe_dj(working_agents=args.working_agents, force=args.force)
        else:
            raise ValueError(f"Unknown command: {cmd}")
        print(json.dumps(out))
        return 0
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
